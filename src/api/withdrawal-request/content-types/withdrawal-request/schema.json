{
  "kind": "collectionType",
  "collectionName": "withdrawal_requests",
  "info": {
    "singularName": "withdrawal-request",
    "pluralName": "withdrawal-requests",
    "displayName": "Withdrawal Request",
    "description": "Withdrawal requests with external transaction tracking"
  },
  "options": {
    "draftAndPublish": false,
    "privateAttributes": [
      "details",
      "admin_notes",
      "payment_notes",
      "denial_reason",
      "external_transaction_id",
      "payment_reference"
    ]
  },
  "attributes": {
    "publisher": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "withdrawalRequests"
    },
    "amount": {
      "type": "decimal",
      "required": true,
      "min": 0
    },
    "method": {
      "type": "enumeration",
      "enum": [
        "razorpay",
        "paypal",
        "bank_transfer",
        "payoneer"
      ],
      "required": true
    },
    "details": {
      "type": "json",
      "required": true
    },
    "withdrawal_status": {
      "type": "enumeration",
      "enum": [
        "pending",
        "approved",
        "denied",
        "paid"
      ],
      "default": "pending",
      "required": true
    },
    "external_transaction_id": {
      "type": "string",
      "maxLength": 255,
      "description": "External payment transaction ID (PayPal, Bank, etc.)"
    },
    "payment_method_used": {
      "type": "enumeration",
      "enum": [
        "paypal",
        "bank_transfer",
        "razorpay",
        "payoneer",
        "other"
      ],
      "description": "Actual payment method used for this withdrawal"
    },
    "payment_notes": {
      "type": "text",
      "description": "Optional notes about the payment"
    },
    "denial_reason": {
      "type": "text",
      "description": "Reason for denying the withdrawal request"
    },
    "admin_notes": {
      "type": "text",
      "description": "Admin notes about the withdrawal request"
    },
    "payment_reference": {
      "type": "string",
      "maxLength": 255,
      "description": "Payment reference or transaction ID"
    },
    "approved_at": {
      "type": "datetime",
      "description": "When the withdrawal was approved"
    },
    "approved_by": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "description": "Admin who approved the withdrawal"
    },
    "paid_at": {
      "type": "datetime",
      "description": "When the withdrawal was marked as paid"
    },
    "paid_by": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "description": "Admin who marked the withdrawal as paid"
    },
    "rejected_at": {
      "type": "datetime",
      "description": "When the withdrawal was rejected"
    },
    "rejected_by": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "description": "Admin who rejected the withdrawal"
    }
  }
}