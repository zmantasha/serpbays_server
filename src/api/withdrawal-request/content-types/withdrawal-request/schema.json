{
  "kind": "collectionType",
  "collectionName": "withdrawal_requests",
  "info": {
    "singularName": "withdrawal-request",
    "pluralName": "withdrawal-requests",
    "displayName": "Withdrawal Request",
    "description": "Withdrawal requests with external transaction tracking"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "publisher": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "withdrawalRequests"
    },
    "amount": {
      "type": "decimal",
      "required": true,
      "min": 0
    },
    "method": {
      "type": "enumeration",
      "enum": ["razorpay", "paypal", "bank_transfer", "payoneer"],
      "required": true
    },
    "details": {
      "type": "json",
      "required": true
    },
    "withdrawal_status": {
      "type": "enumeration",
      "enum": ["pending", "approved", "denied", "paid"],
      "default": "pending",
      "required": true
    },
    "external_transaction_id": {
      "type": "string",
      "maxLength": 255,
      "description": "External payment transaction ID (PayPal, Bank, etc.)"
    },
    "payment_method_used": {
      "type": "enumeration",
      "enum": ["paypal", "bank_transfer", "razorpay", "payoneer", "other"],
      "description": "Actual payment method used for this withdrawal"
    },
    "payment_notes": {
      "type": "text",
      "description": "Optional notes about the payment"
    },
    "denial_reason": {
      "type": "text",
      "description": "Reason for denying the withdrawal request"
    }
  }
}

