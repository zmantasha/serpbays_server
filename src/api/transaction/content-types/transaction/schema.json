{
  "kind": "collectionType",
  "collectionName": "transactions",
  "info": {
    "singularName": "transaction",
    "pluralName": "transactions",
    "displayName": "Transaction",
    "description": "Wallet transactions for deposits, withdrawals, and escrow"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "type": {
      "type": "enumeration",
      "enum": [
        "deposit",
        "promo",
        "escrow_hold",
        "escrow_release",
        "payment",
        "withdrawal",
        "fee",
        "refund",
        "payout"
      ],
      "required": true
    },
    "amount": {
      "type": "decimal",
      "required": true,
      "min": 0
    },
    "transactionStatus": {
      "type": "enumeration",
      "enum": [
        "pending",
        "success",
        "failed",
        "cancelled",
        "approved",
        "refunded",
        "denied",
        "paid"
      ],
      "default": "pending",
      "required": true
    },
    "gateway": {
      "type": "enumeration",
      "enum": [
        "stripe",
        "paypal",
        "razorpay",
        "promo",
        "voucher",
        "system",
        "bank_transfer"
      ],
      "required": true
    },
    "gatewayTransactionId": {
      "type": "string",
      "required": true
    },
    "metadata": {
      "type": "json"
    },
    "user_wallet": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::user-wallet.user-wallet",
      "inversedBy": "transactions"
    },
    "description": {
      "type": "text"
    },
    "users_permissions_user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "transactions"
    },
    "fee": {
      "type": "decimal",
      "default": 0,
      "min": 0
    },
    "netAmount": {
      "type": "decimal",
      "required": true,
      "min": 0
    },
    "order": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::order.order",
      "inversedBy": "transactions"
    },
    "invoice": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::invoice.invoice"
    },
    "external_transaction_id": {
      "type": "string",
      "maxLength": 255,
      "description": "External payment transaction ID (PayPal, Bank, etc.)"
    },
    "payment_notes": {
      "type": "text",
      "description": "Payment notes from withdrawal request"
    },
    "denial_reason": {
      "type": "text",
      "description": "Reason for denying withdrawal request"
    },
    "promo_code_id": {
      "type": "string",
      "description": "ID of the promo code used for this transaction"
    },
    "fund_source": {
      "type": "enumeration",
      "enum": [
        "main_fund",
        "promo_fund"
      ],
      "description": "Source of funds for this transaction"
    },
    "email_sent_at": {
      "type": "datetime",
      "description": "Timestamp when the transaction notification email was sent; guards against duplicate sends from webhook retries and admin re-runs"
    },
    "completedAt": {
      "type": "datetime",
      "description": "Timestamp when the transaction reached a terminal success state (set by gateway webhooks)"
    },
    "failedAt": {
      "type": "datetime",
      "description": "Timestamp when the transaction was marked failed (set by gateway webhooks or manual failure)"
    },
    "canceledAt": {
      "type": "datetime",
      "description": "Timestamp when the transaction was canceled by the gateway (Stripe payment_intent.canceled, etc.)"
    }
  }
}
