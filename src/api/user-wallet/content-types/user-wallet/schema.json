{
  "kind": "collectionType",
  "collectionName": "user_wallets",
  "info": {
    "singularName": "user-wallet",
    "pluralName": "user-wallets",
    "displayName": "User-Wallet",
    "description": "Wallet system for advertisers and publishers"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": {
      "visible": true
    },
    "content-type-builder": {
      "visible": true
    }
  },
  "attributes": {
    "type": {
      "type": "string",
      "default": "unified",
      "required": true
    },
    "currency": {
      "type": "string",
      "default": "USD",
      "required": true
    },
    "balance": {
      "type": "decimal",
      "default": 0,
      "required": true,
      "min": 0,
      "description": "Total balance (mainBalance + promoBalance) - computed field"
    },
    "mainBalance": {
      "type": "decimal",
      "default": 0,
      "required": true,
      "min": 0,
      "description": "Withdrawable funds from direct payments"
    },
    "promoBalance": {
      "type": "decimal",
      "default": 0,
      "required": true,
      "min": 0,
      "description": "Non-withdrawable funds from vouchers/promo codes"
    },
    "escrowBalance": {
      "type": "decimal",
      "default": 0,
      "required": true,
      "min": 0
    },
    "pendingWithdrawalBalance": {
      "type": "decimal",
      "default": 0,
      "required": true,
      "min": 0,
      "description": "Amount requested for withdrawal but not yet processed"
    },
    "users_permissions_user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "user_wallet"
    },
    "transactions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::transaction.transaction",
      "mappedBy": "user_wallet"
    }
  }
}