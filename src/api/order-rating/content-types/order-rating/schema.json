{
  "kind": "collectionType",
  "collectionName": "order_ratings",
  "info": { "singularName": "order-rating", "pluralName": "order-ratings", "displayName": "Order Rating", "description": "Mutual advertiser<->publisher rating after an order completes (2026-09-27)" },
  "options": { "draftAndPublish": false },
  "attributes": {
    "order": { "type": "relation", "relation": "manyToOne", "target": "api::order.order" },
    "rater": { "type": "relation", "relation": "manyToOne", "target": "plugin::users-permissions.user" },
    "ratee": { "type": "relation", "relation": "manyToOne", "target": "plugin::users-permissions.user" },
    "raterRole": { "type": "enumeration", "enum": ["advertiser", "publisher"], "required": true },
    "stars": { "type": "integer", "required": true, "min": 1, "max": 5 },
    "tags": { "type": "json" },
    "comment": { "type": "text" },
    "visibleAt": { "type": "datetime" }
  }
}
