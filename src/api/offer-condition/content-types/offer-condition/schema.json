{
    "kind": "collectionType",
    "collectionName": "offer_conditions",
    "info": {
        "singularName": "offer-condition",
        "pluralName": "offer-conditions",
        "displayName": "Offer Condition",
        "description": "Extensible conditions for offers"
    },
    "options": {
        "draftAndPublish": false
    },
    "attributes": {
        "offer": {
            "type": "relation",
            "relation": "manyToOne",
            "target": "api::offer.offer",
            "inversedBy": "offer_conditions"
        },
        "conditionType": {
            "type": "string",
            "required": true,
            "maxLength": 100
        },
        "operator": {
            "type": "enumeration",
            "enum": [
                "in",
                "not_in",
                "equals",
                "gte",
                "lte"
            ],
            "required": true
        },
        "value": {
            "type": "json",
            "required": true
        }
    }
}