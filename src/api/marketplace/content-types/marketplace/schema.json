{
  "kind": "collectionType",
  "collectionName": "marketplaces",
  "info": {
    "singularName": "marketplace",
    "pluralName": "marketplaces",
    "displayName": "Marketplace",
    "description": ""
  },
  "options": {
    "draftAndPublish": false,
    "privateAttributes": [
      "publisher_name",
      "publisher_email",
      "gsc_refresh_token"
    ]
  },
  "attributes": {
    "url": {
      "type": "string",
      "unique": true,
      "required": true
    },
    "price": {
      "type": "integer",
      "required": true,
      "min": 0
    },
    "link_insertion_price": {
      "type": "integer",
      "min": 0
    },
    "tat": {
      "type": "integer"
    },
    "placement_speed": {
      "type": "enumeration",
      "enum": [
        "Ultra Fast",
        "Fast",
        "Normal",
        "Slow"
      ],
      "default": "Normal"
    },
    "min_word_count": {
      "type": "integer",
      "required": true,
      "min": 0
    },
    "adv_li_cbd_pricing": {
      "type": "integer",
      "min": 0
    },
    "adv_li_casino_pricing": {
      "type": "integer",
      "min": 0
    },
    "sample_post": {
      "type": "text"
    },
    "sample_links": {
      "type": "text"
    },
    "backlink_type": {
      "type": "enumeration",
      "enum": [
        "Do follow",
        "No follow"
      ],
      "required": true,
      "default": "Do follow"
    },
    "category": {
      "type": "json",
      "required": true
    },
    "other_category": {
      "type": "json"
    },
    "guidelines": {
      "type": "text"
    },
    "description": {
      "type": "text",
      "description": "Website description and audience information"
    },
    "publication_location": {
      "type": "text",
      "description": "Where the article will be published - publisher-defined text describing publication location"
    },
    "backlink_validity": {
      "type": "string",
      "required": true
    },
    "ahrefs_dr": {
      "type": "decimal",
      "min": 0,
      "max": 100
    },
    "ahrefs_traffic": {
      "type": "integer",
      "min": 0
    },
    "ahrefs_rank": {
      "type": "integer",
      "min": 0
    },
    "ahrefs_keywords": {
      "type": "integer",
      "min": 0
    },
    "moz_da": {
      "type": "decimal",
      "max": 100,
      "min": 0
    },
    "fast_placement_status": {
      "type": "boolean",
      "default": false
    },
    "publisher_name": {
      "type": "string",
      "required": true
    },
    "publisher_email": {
      "type": "email",
      "required": true
    },
    "publisher": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "description": "Publisher who owns this marketplace listing"
    },
    "publisher_price": {
      "type": "integer",
      "required": true,
      "min": 0
    },
    "publisher_forbidden_gp_price": {
      "type": "integer",
      "min": 0
    },
    "publisher_forbidden_li_price": {
      "type": "integer",
      "min": 0
    },
    "publisher_link_insertion_price": {
      "type": "integer",
      "min": 0
    },
    "publisher_writing_price": {
      "type": "integer",
      "min": 0,
      "description": "The price the publisher charges for writing content (outsourced content orders)"
    },
    "semrush_authority_score": {
      "type": "decimal",
      "min": 0,
      "max": 100
    },
    "semrush_traffic": {
      "type": "integer",
      "min": 0
    },
    "spam_score": {
      "type": "decimal",
      "min": 0,
      "max": 100
    },
    "adv_crypto_pricing": {
      "type": "integer",
      "min": 0
    },
    "adv_casino_pricing": {
      "type": "integer",
      "min": 0
    },
    "adv_cbd_pricing": {
      "type": "integer",
      "min": 0
    },
    "publisher_crypto_pricing": {
      "type": "integer",
      "min": 0
    },
    "publisher_casino_pricing": {
      "type": "integer",
      "min": 0
    },
    "publisher_cbd_pricing": {
      "type": "integer",
      "min": 0
    },
    "adv_dating_pricing": {
      "type": "integer",
      "min": 0
    },
    "adv_li_dating_pricing": {
      "type": "integer",
      "min": 0
    },
    "publisher_dating_pricing": {
      "type": "integer",
      "min": 0
    },
    "publisher_li_dating_pricing": {
      "type": "integer",
      "min": 0
    },
    "publisher_li_casino_pricing": {
      "type": "integer",
      "min": 0
    },
    "publisher_li_cbd_pricing": {
      "type": "integer",
      "min": 0
    },
    "publisher_li_crypto_pricing": {
      "type": "integer",
      "min": 0
    },
    "similarweb_traffic": {
      "type": "integer",
      "min": 0
    },
    "ahrefs_referring_domain": {
      "type": "integer",
      "min": 0
    },
    "domain_zone": {
      "type": "string"
    },
    "only_with_us": {
      "type": "boolean",
      "default": false
    },
    "countries": {
      "type": "json"
    },
    "language": {
      "type": "json",
      "required": true
    },
    "blacklist_status": {
      "type": "enumeration",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "website_status": {
      "type": "enumeration",
      "enum": [
        "pending",
        "active",
        "draft",
        "rejected"
      ],
      "default": "pending",
      "description": "Status of the website submission process"
    },
    "sponsored": {
      "type": "boolean",
      "default": false
    },
    "ugc": {
      "type": "boolean",
      "default": false
    },
    "dofollow_link": {
      "type": "integer",
      "default": 1,
      "min": 0
    },
    "orders": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::order.order",
      "mappedBy": "website"
    },
    "shortlists": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::shortlist.shortlist",
      "mappedBy": "marketplace"
    },
    "adv_li_crypto_pricing": {
      "min": 0,
      "type": "integer"
    },
    "digital_pr": {
      "type": "boolean",
      "default": false
    },
    "gsc_verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether the website is verified through Google Search Console"
    },
    "gsc_verified_at": {
      "type": "datetime",
      "description": "Timestamp when Google Search Console verification was completed"
    },
    "gsc_permission_level": {
      "type": "enumeration",
      "enum": [
        "siteOwner",
        "siteFullUser",
        "siteUnverifiedUser",
        "siteRestrictedUser"
      ],
      "private": true,
      "description": "Permission level in Google Search Console"
    },
    "gsc_refresh_token": {
      "type": "text",
      "private": true,
      "description": "Encrypted Google Search Console refresh token for API access"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "active",
        "paused",
        "draft",
        "rejected",
        "delisted"
      ],
      "default": "active",
      "description": "Current status of the marketplace listing"
    },
    "delistedReason": {
      "type": "enumeration",
      "enum": [
        "ownership_transferred",
        "admin_action",
        "violation",
        "other"
      ],
      "description": "Reason why the listing was delisted"
    },
    "delistedAt": {
      "type": "datetime",
      "description": "When the listing was delisted"
    },
    "approvalStatus": {
      "type": "enumeration",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "approved",
      "description": "Manual approval gate for marketplace visibility"
    },
    "dataVersion": {
      "type": "integer",
      "default": 0,
      "description": "Incremental version for concurrency control"
    },
    "isFeatured": {
      "type": "boolean",
      "default": false,
      "description": "Legacy field - kept for backward compatibility. Use isFeaturedGuestPost / isFeaturedLinkInsertion instead."
    },
    "isFeaturedGuestPost": {
      "type": "boolean",
      "default": false,
      "description": "When true, website appears at the top of Guest Post marketplace listings"
    },
    "isFeaturedLinkInsertion": {
      "type": "boolean",
      "default": false,
      "description": "When true, website appears at the top of Link Insertion marketplace listings"
    },
    "updateRequests": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::website-update-request.website-update-request",
      "mappedBy": "marketplace"
    },
    "updateHistory": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::marketplace-update-history.marketplace-update-history",
      "mappedBy": "marketplace"
    },
    "lastPriceUpdateAt": {
      "type": "datetime",
      "description": "Most recent change timestamp for any tracked price field. Stamped automatically by the marketplace lifecycle hook."
    },
    "lastMetricUpdateAt": {
      "type": "datetime",
      "description": "Most recent change timestamp for any tracked metric field. Stamped automatically by the marketplace lifecycle hook."
    },
    "lastAhrefsRefreshAt": {
      "type": "datetime",
      "description": "Last time this row was refreshed from an Ahrefs source (bulk CSV or JIT). Drives the per-tool freshness dashboard."
    },
    "lastMozRefreshAt": {
      "type": "datetime",
      "description": "Last time this row was refreshed from a Moz source (bulk CSV or JIT)."
    },
    "lastSemrushRefreshAt": {
      "type": "datetime",
      "description": "Last time this row was refreshed from a Semrush source (bulk CSV or JIT)."
    },
    "lastAhrefsExportAt": {
      "type": "datetime",
      "description": "Last time this row was included in an Ahrefs domain export. Advances on intent (export); refresh-at advances on confirmed upload-back."
    },
    "lastMozExportAt": {
      "type": "datetime",
      "description": "Last time this row was included in a Moz domain export."
    },
    "lastSemrushExportAt": {
      "type": "datetime",
      "description": "Last time this row was included in a Semrush domain export."
    },
    "bulkRefreshSkipTools": {
      "type": "json",
      "description": "Array of tool ids (ahrefs|moz|semrush) the admin has marked \"skip\" for this site so it stops appearing in future cohort exports. Default []."
    }
  }
}