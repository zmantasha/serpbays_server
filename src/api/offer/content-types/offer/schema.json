{
    "kind": "collectionType",
    "collectionName": "offers",
    "info": {
        "singularName": "offer",
        "pluralName": "offers",
        "displayName": "Offer",
        "description": "Offer management system for wallet recharge bonuses"
    },
    "options": {
        "draftAndPublish": false
    },
    "pluginOptions": {
        "content-manager": {
            "visible": true
        },
        "content-type-builder": {
            "visible": true
        }
    },
    "attributes": {
        "offerType": {
            "type": "enumeration",
            "enum": [
                "first_recharge",
                "percentage_bonus",
                "flat_bonus",
                "limited_time",
                "coupon_based",
                "min_recharge",
                "user_specific",
                "campaign"
            ],
            "required": true
        },
        "title": {
            "type": "string",
            "required": true,
            "maxLength": 255
        },
        "description": {
            "type": "text"
        },
        "bonusType": {
            "type": "enumeration",
            "enum": [
                "percentage",
                "flat"
            ],
            "required": true
        },
        "bonusValue": {
            "type": "decimal",
            "required": true,
            "min": 0
        },
        "maxBonusCap": {
            "type": "decimal",
            "min": 0
        },
        "minRechargeAmount": {
            "type": "decimal",
            "default": 0,
            "min": 0
        },
        "couponCode": {
            "type": "string",
            "maxLength": 50
        },
        "applicableUserType": {
            "type": "enumeration",
            "enum": [
                "new",
                "existing",
                "all"
            ],
            "default": "all",
            "required": true
        },
        "priority": {
            "type": "integer",
            "default": 10,
            "min": 1
        },
        "isStackable": {
            "type": "boolean",
            "default": false
        },
        "isEnabled": {
            "type": "boolean",
            "default": true
        },
        "startDate": {
            "type": "datetime",
            "required": true
        },
        "endDate": {
            "type": "datetime",
            "required": true
        },
        "perUserLimit": {
            "type": "integer",
            "min": 0
        },
        "globalLimit": {
            "type": "integer",
            "min": 0
        },
        "metadata": {
            "type": "json"
        },
        "offer_conditions": {
            "type": "relation",
            "relation": "oneToMany",
            "target": "api::offer-condition.offer-condition",
            "mappedBy": "offer"
        },
        "offer_usages": {
            "type": "relation",
            "relation": "oneToMany",
            "target": "api::offer-usage.offer-usage",
            "mappedBy": "offer"
        }
    }
}