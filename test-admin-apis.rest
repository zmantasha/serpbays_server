  "active": true
}

### 25. Generate Transaction Report
GET http://localhost:1337/api/admin/transactions/report?startDate=2024-01-01&endDate=2024-12-31
Authorization: Bearer {{token}}

### 26. Bulk Import Marketplace Websites
POST http://localhost:1337/api/admin/marketplace/bulk-import
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "websites": [
    {
      "domain": "example-blog.com",
      "title": "Example Blog",
      "category": "Technology",
      "da": 35,
