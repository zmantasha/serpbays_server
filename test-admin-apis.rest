Authorization: Bearer {{token}}

### 16. Get Communication Statistics
GET http://localhost:1337/api/admin/communications/stats
Authorization: Bearer {{token}}

### 17. Get Marketplace Websites List
GET http://localhost:1337/api/admin/marketplace?page=1&pageSize=10
Authorization: Bearer {{token}}

### 18. Get Marketplace Statistics
GET http://localhost:1337/api/admin/marketplace/stats
Authorization: Bearer {{token}}

### 19. Send Admin Message
POST http://localhost:1337/api/admin/communications/send
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "orderId": 1,
  "message": "This is an admin message for testing",
  "messageType": "admin_notification"
}

### 20. Update Order Status
PUT http://localhost:1337/api/admin/orders/1/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "orderStatus": "in_progress",
  "adminNotes": "Order reviewed and approved by admin"
}

### 21. Approve Transaction
PUT http://localhost:1337/api/admin/transactions/1/approve
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "notes": "Transaction approved after verification"
}

### 22. Approve Withdrawal Request
PUT http://localhost:1337/api/admin/withdrawals/1/approve
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "adminNotes": "Withdrawal approved",
  "paymentReference": "PAY-123456789"
}

### 23. Update Marketplace Website
PUT http://localhost:1337/api/admin/marketplace/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Updated Website Title",
  "category": "Technology",
  "metrics": {
    "da": 45,
    "dr": 40,
    "traffic": "50K"
  },
  "financial": {
