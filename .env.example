HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified

# ============================================
# AutoSend Email Configuration
# ============================================
# Get your API key from: https://autosend.com/dashboard
AUTOSEND_API_KEY=your_autosend_api_key_here

# Universal template for all order status emails (uses conditional logic)
AUTOSEND_TEMPLATE_ORDER_UNIVERSAL=A-6b3a9831dc557c0df9ab

# Universal template for all transaction status emails (uses conditional logic)
AUTOSEND_TEMPLATE_TRANSACTION_UNIVERSAL=A-fec3e40871b864b733af

# Email Sender Information
EMAIL_FROM=noreply@serpbays.com
EMAIL_REPLY_TO=support@serpbays.com

# Marketing Lists
AUTOSEND_FAVORITE_REMINDER_LIST_ID=your_favorite_reminder_list_id_here

# Client URL (used in email links)
CLIENT_URL=http://localhost:3000

# Clerk session-token verification (used by /api/auth/clerk/sync)
# Get the Clerk Frontend API URL from your Clerk dashboard (Settings → API Keys).
# Example for the staging instance: https://frank-caiman-16.clerk.accounts.dev
CLERK_JWKS_URL=https://YOUR_CLERK_INSTANCE.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWT_ISSUER=https://YOUR_CLERK_INSTANCE.clerk.accounts.dev

# ExchangeRate-API (https://app.exchangerate-api.com) — required for live USD→INR FX.
# If unset the service falls back to a static rate (FALLBACK_USD_TO_INR in code),
# which is fine for dev but will produce stale Razorpay charges in production.
# Audit C10: a previous hardcoded fallback key was removed and rotated 2026-06-17.
EXCHANGE_RATE_API_KEY=your_exchangerate_api_key_here

# Optional: override the static USD→INR fallback rate when the API is unavailable.
USD_TO_INR_RATE=83.25

# ============================================
# Performance / scaling (perf-pass-10)
# ============================================
# Postgres connection pool — knex per-process. Strapi default is 10 which
# saturates at ~50 concurrent requests. For 1000s of users target 30-50
# per pod, and ensure PG max_connections > sum(pool × pods × 1.2 buffer).
# When running >1 pod, put PgBouncer (transaction mode) between Strapi
# and Postgres so individual pod pools fan out efficiently.
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# Redis for Socket.IO multi-pod fan-out + cross-pod atomic seq counters.
# When unset, Strapi uses the default in-memory Socket.IO adapter, which
# does NOT span pods — pod A emits, only pod-A sockets see it. The
# bootstrap explicitly logs which adapter path was chosen on boot.
# Format: redis://[:password@]host:port[/db]
REDIS_URL=redis://localhost:6379
